<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>BLUE CAT — Premium Men's Fashion</title>
<meta name="description" content="BLUE CAT — Premium men's fashion, footwear, accessories and essentials.">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
:root{
  --ink:#14161a;
  --ink-soft:#555b64;
  --paper:#f6f4ef;
  --white:#fff;
  --blue:#1c3a63;
  --blue-deep:#10243e;
  --blue-soft:#e8eef5;
  --line:#dedbd3;
  --gold:#b08d57;
  --danger:#b43d32;
  --max:1240px;
  --head:"Archivo",Arial,sans-serif;
  --body:"Inter",Arial,sans-serif;
}

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

html{
  scroll-behavior:smooth;
}

body{
  background:var(--paper);
  color:var(--ink);
  font-family:var(--body);
  line-height:1.5;
}

button,input{
  font:inherit;
}

button{
  cursor:pointer;
}

a{
  text-decoration:none;
  color:inherit;
}

img{
  width:100%;
  display:block;
}

.container{
  width:min(var(--max),calc(100% - 40px));
  margin:auto;
}

/* TOP BAR */

.topbar{
  background:var(--blue-deep);
  color:#fff;
  text-align:center;
  padding:9px 15px;
  font-size:12px;
  letter-spacing:.4px;
}

/* HEADER */

header{
  background:rgba(246,244,239,.96);
  border-bottom:1px solid var(--line);
  position:sticky;
  top:0;
  z-index:1000;
  backdrop-filter:blur(12px);
}

.nav{
  min-height:76px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:25px;
}

.logo{
  font-family:var(--head);
  font-size:27px;
  font-weight:800;
  letter-spacing:3px;
  color:var(--blue);
}

.logo span{
  color:var(--gold);
}

.menu{
  display:flex;
  gap:28px;
  align-items:center;
  font-size:14px;
  font-weight:600;
}

.menu a{
  position:relative;
}

.menu a::after{
  content:"";
  position:absolute;
  left:0;
  bottom:-7px;
  width:0;
  height:2px;
  background:var(--blue);
  transition:.25s;
}

.menu a:hover::after{
  width:100%;
}

.actions{
  display:flex;
  align-items:center;
  gap:9px;
}

.icon-btn{
  width:42px;
  height:42px;
  border:1px solid var(--line);
  background:transparent;
  display:grid;
  place-items:center;
  font-size:18px;
  border-radius:3px;
}

.icon-btn:hover{
  background:var(--blue);
  color:white;
}

.cart-count{
  position:absolute;
  margin-left:-13px;
  margin-top:-24px;
  background:var(--gold);
  color:#fff;
  border-radius:50%;
  width:18px;
  height:18px;
  font-size:10px;
  display:grid;
  place-items:center;
}

.mobile-menu{
  display:none;
}

/* HERO */

.hero{
  min-height:590px;
  display:grid;
  grid-template-columns:1fr 1fr;
  background:#e9e6de;
}

.hero-copy{
  display:flex;
  flex-direction:column;
  justify-content:center;
  padding:70px max(30px,calc((100vw - var(--max))/2));
  padding-right:70px;
}

.eyebrow{
  color:var(--blue);
  font-size:12px;
  font-weight:800;
  letter-spacing:2px;
  text-transform:uppercase;
  margin-bottom:18px;
}

.hero h1{
  font-family:var(--head);
  font-size:clamp(48px,6vw,82px);
  line-height:.95;
  letter-spacing:-3px;
  max-width:650px;
}

.hero h1 span{
  color:var(--blue);
}

.hero p{
  margin:25px 0 32px;
  max-width:510px;
  color:var(--ink-soft);
  font-size:16px;
}

.btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  border:0;
  padding:15px 25px;
  font-size:13px;
  font-weight:800;
  letter-spacing:.5px;
  transition:.2s;
}

.btn-dark{
  background:var(--blue-deep);
  color:white;
}

.btn-dark:hover{
  background:var(--blue);
  transform:translateY(-2px);
}

.btn-light{
  background:white;
  color:var(--ink);
  border:1px solid var(--line);
}

.hero-buttons{
  display:flex;
  gap:10px;
  flex-wrap:wrap;
}

.hero-image{
  min-height:590px;
  background:
  linear-gradient(90deg,rgba(16,36,62,.08),rgba(16,36,62,.05)),
  url("https://images.unsplash.com/photo-1617137968427-85924c800a22?auto=format&fit=crop&w=1400&q=85")
  center/cover;
}

/* SECTION */

section{
  padding:85px 0;
}

.section-head{
  display:flex;
  align-items:end;
  justify-content:space-between;
  gap:20px;
  margin-bottom:32px;
}

.section-head h2{
  font-family:var(--head);
  font-size:38px;
}

.section-head p{
  color:var(--ink-soft);
  max-width:480px;
  font-size:14px;
}

/* CATEGORIES */

.categories{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:14px;
}

.category{
  height:330px;
  position:relative;
  overflow:hidden;
  background:#ddd;
}

.category img{
  height:100%;
  object-fit:cover;
  transition:.5s;
}

.category:hover img{
  transform:scale(1.05);
}

.category::after{
  content:"";
  position:absolute;
  inset:0;
  background:linear-gradient(transparent 45%,rgba(0,0,0,.7));
}

.category-content{
  position:absolute;
  z-index:2;
  left:22px;
  bottom:22px;
  color:white;
}

.category-content h3{
  color:white;
  font-size:25px;
  margin-bottom:5px;
}

.category-content p{
  font-size:12px;
}

/* PRODUCTS */

.product-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:20px;
}

.product{
  background:var(--white);
  position:relative;
  overflow:hidden;
  border:1px solid #ebe8e0;
}

.product-image{
  aspect-ratio:4/5;
  overflow:hidden;
  background:#eee;
}

.product-image img{
  height:100%;
  object-fit:cover;
  transition:.4s;
}

.product:hover .product-image img{
  transform:scale(1.04);
}

.badge{
  position:absolute;
  top:12px;
  left:12px;
  z-index:2;
  background:var(--blue);
  color:white;
  padding:6px 9px;
  font-size:10px;
  font-weight:800;
  letter-spacing:.5px;
}

.product-info{
  padding:17px;
}

.product-category{
  color:#858991;
  font-size:10px;
  font-weight:700;
  text-transform:uppercase;
  letter-spacing:1px;
}

.product h3{
  font-family:var(--head);
  font-size:16px;
  margin:6px 0 9px;
}

.price{
  font-weight:800;
  color:var(--blue);
}

.old-price{
  margin-left:7px;
  color:#999;
  text-decoration:line-through;
  font-size:12px;
}

.add-btn{
  margin-top:14px;
  width:100%;
  border:1px solid var(--blue);
  background:white;
  color:var(--blue);
  padding:11px;
  font-size:12px;
  font-weight:800;
}

.add-btn:hover{
  background:var(--blue);
  color:white;
}

/* BANNER */

.banner{
  background:var(--blue-deep);
  color:white;
  padding:70px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:30px;
}

.banner h2{
  color:white;
  font-size:45px;
  max-width:650px;
}

.banner p{
  color:#cbd5df;
  margin-top:12px;
}

.banner .btn{
  background:white;
  color:var(--blue-deep);
  white-space:nowrap;
}

/* WHY */

.features{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  border-top:1px solid var(--line);
  border-bottom:1px solid var(--line);
}

.feature{
  padding:35px 25px;
  border-right:1px solid var(--line);
}

.feature:last-child{
  border-right:0;
}

.feature-icon{
  font-size:25px;
  margin-bottom:13px;
}

.feature h3{
  font-size:15px;
  margin-bottom:7px;
}

.feature p{
  color:var(--ink-soft);
  font-size:12px;
}

/* NEWSLETTER */

.newsletter{
  background:var(--blue-soft);
  text-align:center;
}

.newsletter h2{
  font-size:38px;
}

.newsletter p{
  color:var(--ink-soft);
  margin:13px auto 25px;
}

.newsletter-form{
  max-width:530px;
  margin:auto;
  display:flex;
}

.newsletter-form input{
  flex:1;
  border:1px solid var(--line);
  padding:15px;
  outline:none;
  background:white;
}

.newsletter-form button{
  border:0;
  background:var(--blue-deep);
  color:white;
  padding:0 24px;
  font-weight:800;
}

/* FOOTER */

footer{
  background:#101318;
  color:#dfe3e8;
  padding:65px 0 25px;
}

.footer-grid{
  display:grid;
  grid-template-columns:2fr 1fr 1fr 1fr;
  gap:45px;
}

.footer-logo{
  color:white;
  font-family:var(--head);
  font-size:26px;
  font-weight:800;
  letter-spacing:3px;
}

.footer-about{
  color:#9299a3;
  font-size:13px;
  max-width:330px;
  margin-top:15px;
}

footer h4{
  color:white;
  font-size:13px;
  margin-bottom:16px;
}

.footer-links{
  display:grid;
  gap:10px;
  font-size:12px;
  color:#9da4ad;
}

.footer-links a:hover{
  color:white;
}

.copyright{
  border-top:1px solid #292d33;
  margin-top:50px;
  padding-top:20px;
  color:#777e87;
  font-size:11px;
  display:flex;
  justify-content:space-between;
}

/* SEARCH MODAL */

.modal{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.55);
  z-index:3000;
  display:none;
  align-items:flex-start;
  justify-content:center;
  padding-top:90px;
}

.modal.active{
  display:flex;
}

.search-box{
  width:min(650px,calc(100% - 30px));
  background:white;
  padding:25px;
}

.search-box input{
  width:100%;
  border:0;
  border-bottom:2px solid var(--blue);
  padding:15px 5px;
  outline:0;
  font-size:18px;
}

.close{
  float:right;
  border:0;
  background:none;
  font-size:24px;
}

/* CART DRAWER */

.cart{
  position:fixed;
  right:-420px;
  top:0;
  width:min(420px,100%);
  height:100%;
  background:white;
  z-index:2500;
  box-shadow:-10px 0 35px rgba(0,0,0,.15);
  transition:.3s;
  display:flex;
  flex-direction:column;
}

.cart.active{
  right:0;
}

.cart-head{
  padding:22px;
  border-bottom:1px solid var(--line);
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.cart-head h2{
  font-size:20px;
}

.cart-items{
  flex:1;
  overflow:auto;
  padding:20px;
}

.empty-cart{
  text-align:center;
  color:#777;
  margin-top:70px;
}

.cart-item{
  display:flex;
  gap:12px;
  border-bottom:1px solid var(--line);
  padding:14px 0;
}

.cart-item img{
  width:75px;
  height:90px;
  object-fit:cover;
}

.cart-item h4{
  font-size:14px;
}

.cart-item p{
  color:var(--blue);
  font-weight:700;
  font-size:13px;
  margin-top:6px;
}

.remove{
  border:0;
  background:none;
  color:var(--danger);
  font-size:11px;
  margin-top:7px;
}

.cart-bottom{
  padding:20px;
  border-top:1px solid var(--line);
}

.total{
  display:flex;
  justify-content:space-between;
  font-weight:800;
  margin-bottom:15px;
}

.checkout{
  width:100%;
  background:var(--blue-deep);
  color:white;
  border:0;
  padding:15px;
  font-weight:800;
}

/* MOBILE */

@media(max-width:900px){

  .menu{
    display:none;
  }

  .mobile-menu{
    display:block;
  }

  .hero{
    grid-template-columns:1fr;
  }

  .hero-copy{
    padding:70px 20px;
  }

  .hero-image{
    min-height:430px;
  }

  .categories{
    grid-template-columns:repeat(2,1fr);
  }

  .product-grid{
    grid-template-columns:repeat(2,1fr);
  }

  .features{
    grid-template-columns:repeat(2,1fr);
  }

  .feature:nth-child(2){
    border-right:0;
  }

  .feature{
    border-bottom:1px solid var(--line);
  }

  .footer-grid{
    grid-template-columns:1fr 1fr;
  }

  .banner{
    padding:45px 25px;
    flex-direction:column;
    align-items:flex-start;
  }
}

@media(max-width:550px){

  .container{
    width:min(var(--max),calc(100% - 28px));
  }

  .nav{
    min-height:65px;
  }

  .logo{
    font-size:22px;
  }

  .actions .icon-btn{
    width:37px;
    height:37px;
  }

  .hero h1{
    font-size:52px;
  }

  .hero-image{
    min-height:360px;
  }

  section{
    padding:60px 0;
  }

  .section-head{
    display:block;
  }

  .section-head h2{
    font-size:30px;
    margin-bottom:10px;
  }

  .categories{
    grid-template-columns:1fr 1fr;
    gap:8px;
  }

  .category{
    height:240px;
  }

  .category-content{
    left:14px;
    bottom:14px;
  }

  .category-content h3{
    font-size:19px;
  }

  .product-grid{
    gap:10px;
  }

  .product-info{
    padding:12px;
  }

  .product h3{
    font-size:14px;
  }

  .banner h2{
    font-size:32px;
  }

  .features{
    grid-template-columns:1fr;
  }

  .feature,
  .feature:nth-child(2){
    border-right:0;
  }

  .footer-grid{
    grid-template-columns:1fr;
  }

  .copyright{
    display:block;
  }

  .copyright span{
    display:block;
    margin-top:8px;
  }

  .newsletter-form{
    flex-direction:column;
    gap:8px;
  }

  .newsletter-form button{
    padding:14px;
  }
}
</style>
</head>

